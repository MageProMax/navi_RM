Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
    - Class: rviz_default_plugins/Map
      Name: Edited 2D map
      Enabled: true
      Alpha: 0.6
      Color Scheme: map
      Topic:
        Value: /map_preview/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Synced PCD
      Enabled: true
      Topic:
        Value: /map_preview/cloud_pcd
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Size (m): 0.025
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: map
      Distance: 24
      Pitch: 1.1
      Yaw: 0.7
      Focal Point:
        X: 6
        Y: -4
        Z: 1
Window Geometry:
  Width: 1400
  Height: 900
