<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find rm_bnrobot_sim)/urdf/bngu_sentinel/common_inertia.xacro" />
    
    <!-- base_link 直接以地面为 z=0，与实机 TF 定义一致。 -->
    <xacro:macro name="base_xacro" params="length width height">
        <link name="base_link">
            <visual>
                <origin xyz="0 0 ${height/2.0+0.055}" rpy="0 0 0" />
                <geometry>
                    <box size="${length} ${width} ${height}" /> <!-- 长×宽×高 -->
                </geometry>
                <material name="blue">
                    <color rgba="0.1 0.1 1.0 0.5"/>
                </material>
            </visual>

            <!-- 碰撞：与视觉尺寸一致 -->
            <collision>
                <origin xyz="0 0 ${height/2.0+0.055}" rpy="0 0 0" />
                <geometry>
                    <box size="${length} ${width} ${height}" />
                </geometry>
                <material name="blue">
                    <color rgba="0.1 0.1 1.0 0.5"/>
                </material>
            </collision>
            <inertial>
                <origin xyz="0 0 ${height/2.0+0.055}" rpy="0 0 0" />
                <mass value="1.0" />
                <inertia ixx="${(1.0/12.0) * (width*width + height*height)}" ixy="0.0" ixz="0.0"
                         iyy="${(1.0/12.0) * (length*length + height*height)}" iyz="0.0"
                         izz="${(1.0/12.0) * (length*length + width*width)}" />
            </inertial>
        </link>
    </xacro:macro>
</robot>
